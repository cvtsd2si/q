fn main() -> i64 {
    let x: i64 = 0;
    x += 3;
    print x;
    x -= 1;
    print x;
    x *= 2;
    print x;
    x /= 4;
    print x;
    x %= 2;
    print x;
    x <<= 2;
    print x;
    x >>= 1;
    print x;
    x |= 1;
    print x;
    x &= 1;
    print x;
    x ^= 1;
    print x;
    ret 0;
}
